---
import BaseLayout from "./BaseLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  headingHtmls?: string[];
}

const { post, headings = [], headingHtmls = [] } = Astro.props;
const { title, description, date, tags } = post.data;

const enrichedHeadings = headings.map((h, i) => ({
  ...h,
  html: headingHtmls[i] || h.text,
}));

const toc = enrichedHeadings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={`${title} · GFXVis`} description={description}>
  <article>
    <header class="mb-8 border-b border-border pb-6">
      <h1 class="text-3xl font-bold text-ink">{title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-muted">
        <time datetime={date.toISOString()}
          >{date.toLocaleDateString("zh-CN")}</time
        >
        <span class="flex flex-wrap gap-2">
          {
            tags.map((tag) => (
              <a
                href={`/tags/${tag}`}
                class="rounded-full border border-border px-2 py-0.5 text-xs transition-colors hover:border-accent hover:text-accent"
              >
                {tag}
              </a>
            ))
          }
        </span>
      </div>
    </header>
    <div class="prose prose-slate max-w-none dark:prose-invert">
      <slot />
    </div>

    <!-- Floating Copy Permalink Toast Notification -->
    <div
      id="heading-copy-toast"
      class="pointer-events-none fixed bottom-20 right-6 z-50 flex items-center gap-2.5 rounded-xl border border-border/90 bg-surface/95 px-4 py-2.5 text-xs font-medium text-ink shadow-lg backdrop-blur-md transition-all duration-300 opacity-0 translate-y-3 select-none"
      role="status"
      aria-live="polite"
    >
      <span
        class="flex h-5 w-5 items-center justify-center rounded-full bg-accent/15 text-accent text-xs font-bold"
      >
        ✓
      </span>
      <span id="heading-copy-toast-text">已复制小节链接到剪贴板</span>
    </div>

    {
      toc.length > 0 && (
        <>
          {/* Left-side TOC Bookmark Button with > chevron */}
          <button
            id="toc-toggle-btn"
            type="button"
            class="fixed left-0 top-1/2 -translate-y-1/2 z-40 flex h-14 w-6 items-center justify-center rounded-r-lg border-y border-r border-l-0 border-border/80 bg-surface/90 text-muted shadow-md backdrop-blur-md transition-all duration-200 hover:w-7.5 hover:border-accent hover:text-accent hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-accent/50 select-none group"
            aria-label="打开文章目录"
            title="文章目录"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-200 group-hover:translate-x-0.5"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>

          {/* TOC Glass Drawer on Left Side */}
          <aside
            id="toc-drawer"
            class="invisible pointer-events-none fixed top-0 left-0 z-50 flex h-full w-80 max-w-[85vw] flex-col border-r border-border/80 bg-surface/95 shadow-2xl backdrop-blur-xl transition-transform duration-300 ease-out -translate-x-full"
            aria-label="文章大纲目录"
          >
            <div class="flex items-center justify-between border-b border-border/80 px-5 py-4">
              <div class="flex items-center gap-2 text-sm font-semibold text-ink">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-accent"
                >
                  <line x1="3" y1="6" x2="21" y2="6" />
                  <line x1="3" y1="12" x2="15" y2="12" />
                  <line x1="3" y1="18" x2="18" y2="18" />
                </svg>
                <span>文章目录</span>
              </div>
              <button
                id="toc-close-btn"
                type="button"
                class="rounded-lg p-1.5 text-muted transition-colors hover:bg-surface-alt hover:text-ink"
                aria-label="关闭目录"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
              </button>
            </div>
            <nav class="flex-1 overflow-y-auto p-4">
              <ul class="space-y-1 text-sm">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class:list={[
                        "toc-link block rounded-lg py-1.5 pr-3 text-muted transition-all duration-150 hover:bg-accent/5 hover:text-accent border-l-2 border-transparent",
                        heading.depth === 2
                          ? "pl-3 font-medium"
                          : "pl-6 text-xs",
                      ]}
                      set:html={heading.html}
                    />
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        </>
      )
    }
  </article>
</BaseLayout>

<script src="../scripts/heading-anchors.ts"></script>
<script src="../scripts/toc.ts"></script>

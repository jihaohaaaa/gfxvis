---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Sidebar from "../components/layout/Sidebar.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "GFXVis · 图形学与可视化",
  description = "图形学与可视化技术博客",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("gfxvis-theme") === "dark") {
            document.documentElement.classList.add("dark");
          }
        } catch {
          /* localStorage unavailable */
        }
      })();
    </script>
  </head>
  <body>
    <div class="mx-auto flex min-h-screen max-w-6xl flex-col px-4 sm:px-6">
      <Header />
      <div class="flex flex-1 flex-col gap-8 py-8 md:flex-row">
        <main class="min-w-0 flex-1">
          <slot />
        </main>
        <Sidebar />
      </div>
      <Footer />
    </div>
  </body>
</html>

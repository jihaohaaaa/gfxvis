---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Sidebar from "../components/layout/Sidebar.astro";

interface Props {
  title?: string;
  description?: string;
  /** Render the right-hand tags sidebar (homepage only). */
  showSidebar?: boolean;
}

const {
  title = "GFXVis · 图形学与可视化",
  description = "图形学与可视化技术博客",
  showSidebar = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script src="../scripts/theme.ts"></script>
  </head>
  <body>
    <Header />
    <div
      class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-6xl flex-col px-4 sm:px-6 pt-12 sm:pt-14"
    >
      <div class="flex flex-1 flex-col gap-8 py-8 md:flex-row">
        <main class="min-w-0 flex-1">
          <slot />
        </main>
        {showSidebar && <Sidebar />}
      </div>
      <Footer />
    </div>

    <!-- Floating Action Card: Back to top is main anchor, Focus Mode expands upward on proximity / hover -->
    <div
      id="floating-actions"
      data-state="collapsed"
      class="group fixed bottom-6 right-6 z-40 flex flex-col-reverse items-center rounded-2xl border border-border/80 bg-surface/90 p-1 shadow-lg backdrop-blur-xl transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] select-none hover:border-accent/40 hover:bg-surface/98 hover:shadow-2xl data-[state=peek]:border-accent/30 data-[state=peek]:bg-surface/95 data-[state=peek]:p-1.5 data-[state=peek]:gap-1 data-[state=expanded]:border-accent/40 data-[state=expanded]:bg-surface/98 data-[state=expanded]:shadow-2xl data-[state=expanded]:p-1.5 data-[state=expanded]:gap-1"
    >
      <!-- Back to top floating button (Main Anchor) -->
      <button
        id="back-to-top"
        type="button"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl text-muted/70 transition-all duration-200 hover:bg-accent/15 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent/50 active:scale-90"
        aria-label="回到顶部"
        title="回到顶部"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m18 15-6-6-6 6"></path>
        </svg>
      </button>

      <!-- Focus Mode toggle button (Expandable upward item) -->
      <button
        id="focus-toggle"
        type="button"
        class="pointer-events-none invisible h-0 w-9 opacity-0 translate-y-3 scale-75 overflow-hidden flex cursor-pointer items-center justify-center rounded-xl text-muted transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-accent/15 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent/50 active:scale-90 group-data-[state=peek]:visible group-data-[state=peek]:h-6 group-data-[state=peek]:opacity-60 group-data-[state=peek]:translate-y-1 group-data-[state=peek]:scale-90 group-data-[state=expanded]:pointer-events-auto group-data-[state=expanded]:visible group-data-[state=expanded]:h-9 group-data-[state=expanded]:opacity-100 group-data-[state=expanded]:translate-y-0 group-data-[state=expanded]:scale-100"
        aria-label="进入专注模式 (隐藏顶栏)"
        aria-pressed="false"
        title="进入专注模式 (隐藏顶栏)"
      >
        <svg
          class="icon-focus-enter"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M3 12h3M18 12h3M12 3v3M12 18v3"></path>
        </svg>
        <svg
          class="icon-focus-exit hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Floating Focus Toast Notification -->
    <div
      id="focus-toast"
      class="pointer-events-none fixed bottom-8 left-1/2 -translate-x-1/2 z-50 flex max-w-[90vw] items-center gap-2.5 rounded-xl border border-border/90 bg-surface/95 px-4 py-2.5 text-xs font-medium text-ink shadow-xl backdrop-blur-md transition-all duration-300 opacity-0 translate-y-3 select-none"
      role="status"
      aria-live="polite"
    >
      <span
        class="flex h-5 w-5 items-center justify-center rounded-full bg-accent/15 text-accent text-xs font-bold"
      >
        ◎
      </span>
      <span id="focus-toast-text">已开启专注模式</span>
    </div>

    <script src="../scripts/scroll-top.ts"></script>
    <script src="../scripts/focus-mode.ts"></script>
    <script src="../scripts/header-autohide.ts"></script>
  </body>
</html>

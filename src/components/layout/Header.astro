---
const nav = [
  { href: "/", label: "首页" },
  { href: "/posts", label: "文章" },
  { href: "/about", label: "关于" },
];
---

<header
  id="site-header"
  class="fixed top-3 inset-x-0 z-50 flex justify-center px-3 sm:px-5 pointer-events-none transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] translate-y-0 will-change-transform"
>
  <div
    class="pointer-events-auto flex w-full max-w-6xl items-center justify-between rounded-2xl border border-border/40 bg-surface/35 px-4 py-3 sm:px-6 shadow-lg shadow-black/5 backdrop-blur-md backdrop-saturate-150 dark:border-border/30 dark:bg-surface/40 dark:shadow-black/20"
  >
    <a href="/" class="text-lg font-bold tracking-tight text-ink">
      GFX<span class="text-accent">Vis</span>
    </a>
    <div class="flex items-center gap-5">
      <nav class="flex items-center gap-5 text-sm">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="text-muted transition-colors hover:text-ink"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-full border border-border p-2 text-muted transition-colors hover:border-accent hover:text-accent"
        aria-label="切换浅色/深色主题"
      >
        <svg
          class="icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </svg>
        <svg
          class="icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

{
  "name": "gfxvis",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26.2.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:headings": "tsx scripts/check-headings.ts",
    "format:bold": "tsx scripts/format-bold.ts",
    "format:bold:check": "tsx scripts/format-bold.ts --check",
    "format": "tsx scripts/format-bold.ts && prettier --write .",
    "format:check": "prettier --check . && tsx scripts/format-bold.ts --check",
    "validate": "pnpm typecheck && pnpm lint && pnpm check:headings && pnpm format:check",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "katex": "^0.18.9",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
